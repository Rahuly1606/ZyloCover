# ══════════════════════════════════════════════════════════════════
# RaahPay Configuration
# ══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────
# MySQL Connection String
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/raahpay

# ── JWT & Security ──────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Admin Key ───────────────────────────────────────────────────────
ADMIN_API_KEY=raahpay-admin-2026

# ── Pricing Parameters ──────────────────────────────────────────────
MIN_PREMIUM_INR=49
MAX_PREMIUM_INR=299
GST_RATE=0.18

# ── Trigger Thresholds ──────────────────────────────────────────────
RAIN_TRIGGER_MM=50
TEMP_TRIGGER_C=42
AQI_TRIGGER=300
WIND_TRIGGER_KMPH=60

# ── Environment ────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO

# ── Mock Data ──────────────────────────────────────────────────────
USE_MOCK_ENV_DATA=True
