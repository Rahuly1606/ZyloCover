# ════════════════════════════════════════════════════════════════════════
# ZYLOCOVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# ════════════════════════════════════════════════════════════════════════

# ───── DATABASE ──────────────────────────────────────────────────────────
# MySQL connection string
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/zylocover

# ───── JWT & SECURITY ────────────────────────────────────────────────────
# Generate a random 32+ character secret key for production
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ───── ADMIN AUTHENTICATION ──────────────────────────────────────────────
ADMIN_API_KEY=your-admin-api-key-change-in-production

# ───── CLOUDINARY (Image Storage for Job Proofs) ──────────────────────────
# Get these from: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ───── WEATHER APIS ──────────────────────────────────────────────────────
# OpenWeather API Key - Get from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Air Quality Index API Key - Get from https://aqicn.org/data-platform/
WAQI_API_KEY=your_waqi_api_key

# ───── APPLICATION SETTINGS ─────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
USE_MOCK_ENV_DATA=false

# ───── PRICING PARAMETERS ────────────────────────────────────────────────
MIN_PREMIUM_INR=49.0
MAX_PREMIUM_INR=299.0
GST_RATE=0.18

# ───── TRIGGER THRESHOLDS (Parameter Insurance) ──────────────────────────
RAIN_TRIGGER_MM=50.0
TEMP_TRIGGER_C=42.0
AQI_TRIGGER=300.0
WIND_TRIGGER_KMPH=60.0

# ───── WEATHER API SETTINGS ──────────────────────────────────────────────
WEATHER_API_TIMEOUT=5
